const express = require('express');
const path = require('path');
const fs = require('fs');
const puppeteer = require('puppeteer');
const { EngineRegistry } = require('../core/registry');
const { Pipeline } = require('../core/pipeline');
const { DefinitionEngine } = require('../engines/definition');
const { FormulaEngine } = require('../engines/formula');
const { RuleEngine } = require('../engines/rule');
const { VersionEngine } = require('../engines/version');
const { ExecutionGraphEngine } = require('../engines/execution-graph');
const { SnapshotEngine } = require('../engines/snapshot');
const leadershipConfig = require('../assessments/leadership/config.json');

const app = express();
const PORT = 3000;

// ========== PERSISTENT STORAGE ==========
const SNAPSHOTS_DIR = path.join(__dirname, '..', 'snapshots'); // atau './snapshots' jika di root
if (!fs.existsSync(SNAPSHOTS_DIR)) {
  fs.mkdirSync(SNAPSHOTS_DIR, { recursive: true });
}

function saveSnapshotToFile(snapshotId, data) {
  const filePath = path.join(SNAPSHOTS_DIR, `${snapshotId}.json`);
  fs.writeFileSync(filePath, JSON.stringify(data, null, 2));
  console.log('💾 Snapshot saved to file:', filePath);
}

function loadSnapshotFromFile(snapshotId) {
  const filePath = path.join(SNAPSHOTS_DIR, `${snapshotId}.json`);
  if (!fs.existsSync(filePath)) return null;
  try {
    const data = fs.readFileSync(filePath, 'utf-8');
    return JSON.parse(data);
  } catch (err) {
    console.error('❌ Error reading snapshot file:', err.message);
    return null;
  }
}

// In-memory cache (untuk fallback/performance)
const snapshots = new Map();

// ========== ENGINE SETUP ==========
const registry = new EngineRegistry();
registry
  .register(new DefinitionEngine())
  .register(new FormulaEngine())
  .register(new RuleEngine())
  .register(new VersionEngine())
  .register(new ExecutionGraphEngine())
  .register(new SnapshotEngine());

const pipeline = new Pipeline({ name: 'leadership-assessment', registry });
pipeline
  .addStage('definition', { required: true })
  .addStage('formula', { required: true })
  .addStage('rule', { required: true })
  .addStage('version', { required: true })
  .addStage('execution-graph', { required: true })
  .addStage('snapshot', { required: true });

// ========== MIDDLEWARE ==========
app.use(express.json());
app.use(express.static('public'));

// ========== ROUTES ==========
// Landing page
app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, 'views', 'index.html'));
});

// Assessment form
app.get('/assessment', (req, res) => {
  res.sendFile(path.join(__dirname, 'views', 'assessment.html'));
});

// Result page
app.get('/result', (req, res) => {
  const snapshotId = req.query.snapshotId;
  if (!snapshotId) {
    return res.redirect('/assessment');
  }
  res.sendFile(path.join(__dirname, 'views', 'result.html'));
});

// ========== API: Submit Assessment ==========
app.post('/api/submit', async (req, res) => {
  console.log('🔹 POST /api/submit received');
  console.log('🔹 Body keys:', Object.keys(req.body));

  try {
    const { name, email, company, responses } = req.body;

    if (!name || !email || !responses) {
      console.log('❌ Missing fields');
      return res.status(400).json({ error: 'Data tidak lengkap' });
    }

    console.log('🔹 Running pipeline...');

    // Run Assessment Engine
    const context = await pipeline.run({
      assessment: leadershipConfig,
      participant: { name, email, company },
      responses
    });

    // Extract snapshot ID
    const snapshotId = context.getSnapshot().snapshotId;
    const formulas = context.getFormulas();
    const rules = context.getRules();
    const version = context.getVersion();

    console.log('🔹 Snapshot ID:', snapshotId);

    // Prepare DTO (Data Transfer Object) - format sederhana untuk frontend
    const snapshotData = {
      snapshotId,
      participant: { name, email, company },
      assessment: {
        id: leadershipConfig.id,
        title: leadershipConfig.title,
        version: leadershipConfig.version
      },
      responses,
      formulas: formulas.results,
      rules: rules.results,
      version: version.version,
      createdAt: context.getSnapshot().createdAt || new Date().toISOString()
    };

    // Simpan ke Map (cache)
    snapshots.set(snapshotId, snapshotData);
    console.log('📦 Map size:', snapshots.size);
    console.log('📋 Map keys:', [...snapshots.keys()]);

    // Simpan ke file (persistent)
    saveSnapshotToFile(snapshotId, snapshotData);

    // Kirim response ke frontend
    res.json({
      success: true,
      snapshotId,
      overall: formulas.results.overall.value,
      category: rules.results[0]?.action?.category || 'Medium'
    });

  } catch (error) {
    console.error('❌ Assessment error:', error);
    res.status(500).json({ error: 'Assessment failed: ' + error.message });
  }
});

// ========== API: Get Snapshot ==========
app.get('/api/snapshot/:snapshotId', (req, res) => {
  const id = req.params.snapshotId;
  console.log('🔍 GET /api/snapshot/' + id);

  // 1. Coba dari Map (cache)
  if (snapshots.has(id)) {
    console.log('✅ Found in Map');
    return res.json(snapshots.get(id));
  }

  // 2. Coba dari file
  const fileData = loadSnapshotFromFile(id);
  if (fileData) {
    console.log('✅ Found in file');
    // Simpan ke cache untuk next request
    snapshots.set(id, fileData);
    return res.json(fileData);
  }

  console.log('❌ Snapshot not found');
  res.status(404).json({ error: 'Snapshot not found' });
});

// ========== API: Generate PDF ==========
app.post('/api/report/pdf', async (req, res) => {
  console.log('🔹 POST /api/report/pdf received');

  try {
    const { snapshotId } = req.body;
    if (!snapshotId) {
      return res.status(400).json({ error: 'snapshotId required' });
    }

    console.log('🔹 Generating PDF for:', snapshotId);

    // Ambil snapshot (coba dari Map dulu, lalu file)
    let snapshot = snapshots.get(snapshotId);
    if (!snapshot) {
      snapshot = loadSnapshotFromFile(snapshotId);
      if (snapshot) snapshots.set(snapshotId, snapshot);
    }

    if (!snapshot) {
      console.log('❌ Snapshot not found');
      return res.status(404).json({ error: 'Snapshot not found' });
    }

    console.log('✅ Snapshot loaded');

    // ========== Generate PDF dengan Puppeteer ==========
    const browser = await puppeteer.launch({
      headless: 'new',
      args: ['--no-sandbox', '--disable-setuid-sandbox']
    });

    const page = await browser.newPage();

    // Build HTML content
    const htmlContent = `
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="UTF-8">
        <title>Leadership Assessment Report</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <style>
          body { font-family: Arial, sans-serif; padding: 20px; }
          .score-display { font-size: 4rem; font-weight: bold; color: #0d6efd; }
          .progress-bar { background-color: #0d6efd; }
          .container { max-width: 800px; margin: 0 auto; }
          .radar-container { max-width: 400px; margin: 0 auto; }
        </style>
      </head>
      <body>
        <div id="report" class="container">
          <h2 class="text-center mb-4">Leadership Assessment Report</h2>

          <div class="mb-4">
            <h5>Participant Information</h5>
            <div class="row">
              <div class="col-6">
                <p><strong>Nama:</strong> ${snapshot.participant.name}</p>
                <p><strong>Email:</strong> ${snapshot.participant.email}</p>
              </div>
              <div class="col-6">
                <p><strong>Perusahaan:</strong> ${snapshot.participant.company}</p>
                <p><strong>Tanggal:</strong> ${new Date(snapshot.createdAt).toLocaleString('id-ID')}</p>
              </div>
            </div>
          </div>

          <hr>

          <div class="text-center mb-4">
            <h5>Overall Leadership Score</h5>
            <div class="score-display">${snapshot.formulas.overall.value}</div>
            <p class="lead">Category: ${snapshot.rules[0]?.action?.category || 'Medium'}</p>
          </div>

          <hr>

          <div class="mb-4">
            <h5>Competency Breakdown</h5>
            <div class="radar-container">
              <canvas id="radarChart" width="400" height="400"></canvas>
            </div>
          </div>

          <hr>

          <div class="mb-4">
            <h5>Dimension Scores</h5>
            ${Object.entries(snapshot.formulas)
              .filter(([key]) => key !== 'overall')
              .map(([key, data]) => `
                <div class="mb-2">
                  <div class="d-flex justify-content-between">
                    <span class="fw-bold">${key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
                    <strong>${data.value}/100</strong>
                  </div>
                  <div class="progress" style="height: 20px;">
                    <div class="progress-bar" style="width: ${data.value}%">${data.value}%</div>
                  </div>
                </div>
              `).join('')}
          </div>

          <hr>

          <div class="mb-4">
            <h5>Recommendation</h5>
            <div class="alert alert-info">
              ${snapshot.rules[0]?.action?.recommendation || 'Terima kasih telah mengikuti assessment.'}
            </div>
          </div>
        </div>

        <script>
          const dims = ${JSON.stringify(
            Object.entries(snapshot.formulas)
              .filter(([key]) => key !== 'overall')
              .reduce((acc, [key, data]) => {
                acc[key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())] = data.value;
                return acc;
              }, {})
          )};

          const ctx = document.getElementById('radarChart').getContext('2d');
          new Chart(ctx, {
            type: 'radar',
            data: {
              labels: Object.keys(dims),
              datasets: [{
                label: 'Score',
                data: Object.values(dims),
                backgroundColor: 'rgba(13, 110, 253, 0.2)',
                borderColor: 'rgba(13, 110, 253, 1)',
                pointBackgroundColor: 'rgba(13, 110, 253, 1)',
                borderWidth: 2
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              scales: {
                r: { beginAtZero: true, max: 100, ticks: { stepSize: 20 } }
              },
              plugins: { legend: { display: false } }
            }
          });
        </script>
      </body>
      </html>
    `;

    console.log('🔹 Setting page content...');
    await page.setContent(htmlContent, { waitUntil: 'networkidle0' });

    // Tunggu chart render
    console.log('🔹 Waiting for chart render...');
    await page.waitForTimeout(1500);

    console.log('🔹 Generating PDF...');
    const pdfBuffer = await page.pdf({
      format: 'A4',
      printBackground: true,
      margin: { top: '20mm', bottom: '20mm', left: '15mm', right: '15mm' }
    });

    await browser.close();

    const filename = `leadership-assessment-${snapshot.participant.name.replace(/\s+/g, '-')}.pdf`;
    console.log('✅ PDF generated:', filename);

    res.set({
      'Content-Type': 'application/pdf',
      'Content-Disposition': `attachment; filename="${filename}"`
    });
    res.send(pdfBuffer);

  } catch (error) {
    console.error('❌ PDF generation error:', error);
    res.status(500).json({ error: 'PDF generation failed: ' + error.message });
  }
});

// ========== START SERVER ==========
app.listen(PORT, () => {
  console.log(`✓ Server running at http://localhost:${PORT}`);
  console.log(`✓ Landing page: http://localhost:${PORT}`);
  console.log(`✓ Assessment: http://localhost:${PORT}/assessment`);
  console.log(`✓ Snapshots directory: ${SNAPSHOTS_DIR}`);
});